# Copy this file to server/.env and fill in real values.
# server/.env is gitignored - never commit credentials.

# Server
PORT=3001
NODE_ENV=development

# Email (SMTP)
# Set to "true" to actually send mail. Leave false locally to test the form
# without sending anything.
MAIL_ENABLED=true

# Your SMTP provider's host and port.
#   Port 587 -> SMTP_SECURE=false (STARTTLS)  <- most common
#   Port 465 -> SMTP_SECURE=true  (implicit TLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP login. For most providers SMTP_USER is the full mailbox address.
SMTP_USER=hunter@tornadoaudio.net
SMTP_PASS=

# The address mail is sent from. Must be an address your SMTP account is
# allowed to send as, or the provider will reject it.
MAIL_FROM=hunter@tornadoaudio.net
MAIL_FROM_NAME=Tornado Audio

# Where contact form inquiries get delivered.
RECIPIENT_EMAIL=hunter@tornadoaudio.net
